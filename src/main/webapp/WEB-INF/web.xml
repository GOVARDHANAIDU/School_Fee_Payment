<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>SAS School Web Application</display-name>

    <!-- Welcome / Starting pages -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- 404 Error Page -->
    <error-page>
        <error-code>404</error-code>
        <location>/404.jsp</location>
    </error-page>

    <!-- 500 Error Page (Recommended to add) -->
    <error-page>
        <error-code>500</error-code>
        <location>/500.jsp</location>
    </error-page>

    <!-- Session timeout (minutes) -->
    <session-config>
        <session-timeout>40</session-timeout>
        <!-- Optional: Enable URL rewriting for session tracking -->
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- Role Based Access Filter -->
    <filter>
        <filter-name>RoleBasedAccessFilter</filter-name>
        <filter-class>com.controller.RoleBasedAccessFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>RoleBasedAccessFilter</filter-name>
        <url-pattern>/*</url-pattern>
        <!-- Consider adding dispatcher types for better control -->
        <dispatcher>REQUEST</dispatcher>
        <dispatcher>FORWARD</dispatcher>
    </filter-mapping>

    <!-- Context parameters (Optional but useful) -->
    <context-param>
        <param-name>applicationName</param-name>
        <param-value>SAS School Management System</param-value>
    </context-param>

</web-app>